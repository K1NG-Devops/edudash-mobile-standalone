# Vercel environment variables for EduDash Pro
# You can import this file on the Vercel Settings > Environment Variables page ("Import .env").
# Replace placeholders (CHANGE_ME) with your real values.

# =====================================================
# Core URLs
# =====================================================
# Public site/API base (used by both web and native clients)
EXPO_PUBLIC_WEB_URL=https://CHANGE_ME.your-domain.tld
NEXT_PUBLIC_APP_URL=https://CHANGE_ME.your-domain.tld

# =====================================================
# Supabase (Client)
# =====================================================
EXPO_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
# Optional public bucket name used by the app
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=avatars
# Optional: enable debug logs for Supabase client in dev
EXPO_PUBLIC_DEBUG_SUPABASE=false
# Optional: allow admin client (local/dev only; DO NOT enable in production)
EXPO_PUBLIC_ENABLE_ADMIN_CLIENT=false
# Optional (local/dev only): non-public server-side key for admin client
# SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# =====================================================
# App Metadata / Localization
# =====================================================
EXPO_PUBLIC_APP_NAME=EduDash Pro
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=production
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_DEFAULT_CURRENCY=ZAR
EXPO_PUBLIC_DEFAULT_LOCALE=en-ZA
EXPO_PUBLIC_DEFAULT_TIMEZONE=Africa/Johannesburg
EXPO_PUBLIC_APP_SCHEME=edudashpro

# =====================================================
# Features (no secrets)
# =====================================================
EXPO_PUBLIC_EMAIL_ENABLED=true
EXPO_PUBLIC_EMAIL_MOCK_MODE=false
EXPO_PUBLIC_ENABLE_AI_FEATURES=true
EXPO_PUBLIC_ENABLE_STEM_ACTIVITIES=true
EXPO_PUBLIC_ENABLE_HOMEWORK_GRADING=true
EXPO_PUBLIC_ENABLE_LESSON_GENERATOR=true
EXPO_PUBLIC_ENABLE_PROGRESS_ANALYSIS=true
EXPO_PUBLIC_ENABLE_PREMIUM_FEATURES=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_ADS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Analytics: PostHog
EXPO_PUBLIC_ENABLE_POSTHOG=true
EXPO_PUBLIC_POSTHOG_KEY=CHANGE_ME_POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GrowthBook: Feature flags
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=CHANGE_ME_GROWTHBOOK_CLIENT_KEY
EXPO_PUBLIC_GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# =====================================================
# Email
# =====================================================
FROM_EMAIL=noreply@CHANGE_ME.your-domain.tld
EXPO_PUBLIC_FROM_EMAIL=noreply@CHANGE_ME.your-domain.tld
# Preferred server-side provider (set at least one of these on Vercel; do NOT expose as EXPO_PUBLIC_* in prod)
# RESEND_API_KEY=CHANGE_ME_RESEND
# SENDGRID_API_KEY=CHANGE_ME_SENDGRID

# =====================================================
# AI
# =====================================================
# If you plan to use Claude (Anthropic)
EXPO_PUBLIC_AI_ENABLED=true
EXPO_PUBLIC_ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_KEY   # Optional; prefer server-side usage where possible
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
EXPO_PUBLIC_ANTHROPIC_MAX_TOKENS=4000

# =====================================================
# Ads (Google AdMob)
# =====================================================
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/aaaaaaaaaa

# =====================================================
# Payments — PayFast (Primary ZA)
# =====================================================
EXPO_PUBLIC_PAYFAST_ENV=production
EXPO_PUBLIC_PAYFAST_MERCHANT_ID=CHANGE_ME_PAYFAST_MERCHANT_ID
EXPO_PUBLIC_PAYFAST_MERCHANT_KEY=CHANGE_ME_PAYFAST_MERCHANT_KEY
EXPO_PUBLIC_PAYFAST_PASSPHRASE=CHANGE_ME_PAYFAST_PASSPHRASE
# Derived URLs used for redirects/webhooks. You can override explicitly if needed.
PAYFAST_RETURN_URL=${EXPO_PUBLIC_WEB_URL}/payment/success
PAYFAST_CANCEL_URL=${EXPO_PUBLIC_WEB_URL}/payment/cancel
PAYFAST_NOTIFY_URL=${EXPO_PUBLIC_WEB_URL}/api/webhooks/payfast

# =====================================================
# Payments — PayPal (Optional / International)
# =====================================================
EXPO_PUBLIC_PAYPAL_ENV=production
EXPO_PUBLIC_PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_CLIENT_ID
EXPO_PUBLIC_PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_CLIENT_SECRET
# Optional explicit overrides for PayPal return/cancel
PAYPAL_RETURN_URL=${EXPO_PUBLIC_WEB_URL}/payment/success
PAYPAL_CANCEL_URL=${EXPO_PUBLIC_WEB_URL}/payment/cancel

# =====================================================
# Expo / Build
# =====================================================
NODE_ENV=production

