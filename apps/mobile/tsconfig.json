{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "esnext",
    "baseUrl": ".",
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/i18n": [
        "src/i18n/index.ts"
      ],
      "@/design-system": [
        "src/design-system/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/**",
    "archive/**",
    "legacy/_excluded/**",
    "app/api/**",
    "app/_api/**",
    "src/design-system/components/__stories__/**",
    "**/__stories__/**"
  ],
  "extends": "expo/tsconfig.base"
}