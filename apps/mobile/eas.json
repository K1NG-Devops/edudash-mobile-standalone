{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADS_INTERSTITIAL_EVERY_N": "3"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      },
      "cache": {
        "disabled": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_ADS_INTERSTITIAL_EVERY_N": "3",
        "EXPO_PUBLIC_ENABLE_POSTHOG": "true",
        "EXPO_PUBLIC_BETA_MODE": "true",
        "EXPO_PUBLIC_SHAKE_TO_REPORT": "true",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_yvYvnGn7Cd9iTsUPobcDsa6E1L2R4AMzrrAutYguIIF",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "cache": {
        "disabled": true
      }
    },
    "preview-aab": {
      "extends": "preview",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_WEB_URL": "https://www.edudashpro.org.za",
        "EXPO_PUBLIC_ADS_INTERSTITIAL_EVERY_N": "3",
        "EXPO_PUBLIC_ENABLE_POSTHOG": "true",
        "EXPO_PUBLIC_BETA_MODE": "false",
        "EXPO_PUBLIC_SHAKE_TO_REPORT": "false"
      },
      "cache": {
        "disabled": false
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production-apk": {
      "extends": "production",
      "channel": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
