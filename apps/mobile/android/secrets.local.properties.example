# Local secrets for Android build (never committed)
# Prefer storing secrets outside the repo at ~/.edudash/android-secrets.properties
# This project also supports android/secrets.local.properties for convenience.
#
# Signing config
storeFile=app/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME

# Example: AdMob app id placeholder (used in AndroidManifest via ${admobAppId})
# See: https://developers.google.com/admob/android/quick-start
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

