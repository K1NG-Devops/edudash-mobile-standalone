# Exclude heavy/local-only content from uploads to Vercel
# Keep source small; Vercel installs dependencies and builds in the cloud.

# Version control and caches
.git/
.expo/
.cache/
.DS_Store

# IDE
.vscode/
.idea/
.cursor/

# Logs and temp
logs/
*.log
*.bak
*.backup
*.old

# Native projects and build outputs (not needed for web deploy)
android/
ios/
.gradle/
*.keystore
*.jks
*.apk
*.aab
*.ipa
build-*.apk
build-*.aab

# Dependencies (installed on Vercel during build)
node_modules/

# Tests and stories
__tests__/
*.test.*
storybook/
*.stories.*
coverage/

# Supabase local artifacts (keep supabase/functions out of upload; web doesn’t need them)
supabase/.branches/
supabase/.temp/
supabase/logs/

# Large archives / data dumps not needed for web build
archived-migrations/
*.sql
*.csv

# Misc
tsconfig.tsbuildinfo
assets/raw-dumps/

# Note: DO NOT exclude src/, app/, assets/, public/ — they are required for the web build.
