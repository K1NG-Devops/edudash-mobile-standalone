{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@edudash/ui/*": ["packages/ui/src/*"],
      "@edudash/api/*": ["packages/api/src/*"],
      "@edudash/types/*": ["packages/types/src/*"]
    }
  }
}

